	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch STM32L073",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/build/test-app.elf",
			"svdFile": "${workspaceFolder}/SVD/STM32L0x3.svd",
			"request": "launch",
			"type": "cortex-debug",
			"servertype": "jlink",
			"device": "STM32L073RZ",
			"interface": "swd",
			"rtos": "FreeRTOS",
			"serialNumber": "",
			"runToEntryPoint": "main",
			"showDevDebugOutput": "both",
			"serverArgs": ["-speed", "4000"],
			"windows": {
				"serverpath": "c:/Program Files/SEGGER/JLink_V796/JLinkGDBServerCL.exe",
			},
			"linux": {
				"serverpath": "JLinkGDBServerCLExe",
				"ipAddress": "192.168.0.1",
			},
			"osx": {
				"serverpath": "JLinkGDBServerCL"
			},
			"rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
		},
		{
			"name": "Launch J-STM32F105",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/build/test-app.elf",
			"svdFile": "${workspaceFolder}/SVD/STM32F107.svd",
			"request": "launch",
			"type": "cortex-debug",
			"servertype": "jlink",
			"device": "STM32F105RB",
			"interface": "swd",
			"rtos": "FreeRTOS",
			"serialNumber": "",
			"runToEntryPoint": "main",
			"showDevDebugOutput": "both",
			"serverArgs": ["-speed", "4000"],
			"windows": {
				"serverpath": "C:/Program Files/SEGGER/JLink/JLinkGDBServerCL.exe",
			},
			"linux": {
				"serverpath": "JLinkGDBServerCLExe",
				"ipAddress": "192.168.0.1",
			},
			"osx": {
				"serverpath": "JLinkGDBServerCL"
			},
			"rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
		},
		{
			"name": "Launch STM32F401",
			"cwd": "${workspaceFolder}",
			"executable": "${workspaceFolder}/build/test-app.elf",
			"svdFile": "${workspaceFolder}/SVD/STM32F401.svd",
			"request": "launch",
			"type": "cortex-debug",
			"servertype": "jlink",
			"device": "STM32F401RE",
			"interface": "swd",
			"rtos": "FreeRTOS",
			"serialNumber": "",
			"runToEntryPoint": "main",
			"showDevDebugOutput": "both",
			"serverArgs": ["-speed", "4000"],
			"windows": {
				"serverpath": "C:/Program Files/SEGGER/JLink/JLinkGDBServerCL.exe",
			},
			"linux": {
				"serverpath": "JLinkGDBServerCLExe",
				"ipAddress": "192.168.0.1",
			},
			"osx": {
				"serverpath": "JLinkGDBServerCL"
			},
			"rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
		},
		{
            "name": "Cortex-Debug OPENOCD",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/test-app.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "gdbPath": "arm-none-eabi-gdb", // Path to your GDB executable
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg" // Your specific target config
            ],
			"searchDir": [
				"C:/OpenOCD/openocd/scripts"
			],
			"serverpath": "openocd",
			"showDevDebugOutput": "raw",
            "gdbTarget": "localhost:3333",
            "runToEntryPoint": "main",
            "device": "STM32F401RE",
            "svdFile": "${workspaceFolder}/SVD/STM32F401.svd",
            "postLaunchCommands": [
                "monitor reset halt",
                "monitor reset init"
            ],
			"swoConfig": {
				"enabled": true,
				"source": "probe",
				"cpuFrequency": 170000000,
				"swoFrequency": 2000000,
				"decoders": [
					{
						"label": "ITM0",
						"port": 0,
						"type": "console"
					}
				]
			}
        }
	]
}